{
  "name": "bearnie",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "version": "0.1.0",
  "registryVersion": "0.10.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run generate-registry",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "generate-registry": "npx tsx scripts/generate-registry.ts",
    "build:cli": "npm run build -w bearnie",
    "build:create": "npm run build -w create-bearnie",
    "build:mcp": "npm run build -w @bearnie/mcp",
    "build:packages": "npm run build:cli && npm run build:create && npm run build:mcp",
    "build:all": "npm run build:packages && npm run build",
    "release": "npx tsx scripts/release.ts",
    "test:smoke": "npm run build:packages && npx tsx scripts/smoke-test.ts",
    "cli:dev": "npm run dev -w bearnie",
    "cli:build": "npm run build -w bearnie",
    "cli:link": "npm link -w bearnie",
    "cli:test": "BEARNIE_REGISTRY_URL=http://localhost:4321/registry bearnie"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@lexingtonthemes/seo": "^0.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "astro": "^7.1.6",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "keen-slider": "^6.8.6",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "fs-extra": "^11.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-scroll-mask": "^0.0.4",
    "tsx": "^4.23.6",
    "typescript": "^5.7.3"
  }
}
