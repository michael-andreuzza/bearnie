{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "form",
        "layout",
        "navigation",
        "feedback",
        "disclosure",
        "display"
      ]
    },
    "status": {
      "default": "stable",
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "experimental"
      ]
    },
    "order": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "category"
  ]
}