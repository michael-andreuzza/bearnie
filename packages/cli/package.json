{
  "name": "bearnie",
  "version": "0.1.7",
  "description": "CLI for installing Bearnie UI components",
  "type": "module",
  "license": "MIT",
  "bin": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.1.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Michael Andreuzza",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-andreuzza/bearnie.git",
    "directory": "packages/cli"
  },
  "homepage": "https://bearnie.dev",
  "bugs": {
    "url": "https://github.com/michael-andreuzza/bearnie/issues"
  },
  "keywords": [
    "astro",
    "ui",
    "components",
    "cli",
    "tailwindcss",
    "bearnie"
  ]
}
