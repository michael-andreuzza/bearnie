---
import { getCollection } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import Badge from "@/components/ui/badge/Badge.astro";
import Text from "@/components/fundations/elements/Text.astro";

const entries = (await getCollection("changelog")).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime() ||
    b.data.order - a.data.order,
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<DocsLayout
  title="Changelog"
  description="New components, upgrades, and fixes across the Bearnie registry, CLI, and MCP server."
  keywords={["astro components changelog", "bearnie releases", "astro ui library updates"]}
>
  <ul class="divide-y divide-border">
    {
      entries.map((entry) => (
        <li class="py-6 first:pt-0 last:pb-0">
          <a href={`/docs/changelog/${entry.id}/`} class="group block">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
              <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                {formatDate(entry.data.date)}
              </time>
              {entry.data.version && (
                <Badge variant="secondary">{entry.data.version}</Badge>
              )}
            </div>
            <Text
              tag="h2"
              variant="textLG"
              class="mt-2 font-semibold tracking-tight group-hover:text-muted-foreground transition-colors"
            >
              {entry.data.title}
            </Text>
            <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground">
              {entry.data.description}
            </Text>
          </a>
        </li>
      ))
    }
  </ul>
</DocsLayout>
