---
// Assets
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { AstroSeo } from "@lexingtonthemes/seo";
import { siteConfig } from "@/config/site";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
const canonical = `${siteConfig.url}${Astro.url.pathname || "/"}`;
---

<AstroSeo
  title={`System Links | ${siteConfig.name}`}
  description="Link styles and states."
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: `System Links | ${siteConfig.name}`,
    description: "Link styles and states.",
    site_name: siteConfig.name,
    type: "website",
    locale: "en_US",
    images: [
      {
        url: siteConfig.ogImage,
        width: 1200,
        height: 630,
        alt: `${siteConfig.name} Open Graph image`,
        type: "image/jpeg",
      },
    ],
  }}
  twitter={{
    cardType: "summary_large_image",
    site: siteConfig.author.twitter,
    handle: siteConfig.author.twitter,
  }}
/>
<Text tag="h2" variant="displaySM" class="font-medium text-base-900">
  Links
</Text>
<div
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 text-base-400 mt-12"
>
  <!-- Default -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Default text
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="default"
          >Default XXS</Button
        >
        <Button isLink={true} href="#_" size="xs" variant="default"
          >Default XS</Button
        >
        <Button isLink={true} href="#_" size="sm" variant="default"
          >Default SM</Button
        >
        <Button isLink={true} href="#_" size="base" variant="default"
          >Default Base</Button
        >
        <Button isLink={true} href="#_" size="md" variant="default"
          >Default MD</Button
        >
        <Button isLink={true} href="#_" size="lg" variant="default"
          >Default LG</Button
        >
        <Button isLink={true} href="#_" size="xl" variant="default"
          >Default XL</Button
        >
      </div>
    </div>
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Icon
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="default" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="xs" variant="default" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="sm" variant="default" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="base" variant="default" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="md" variant="default" iconOnly
          ><Plus slot="icon" size="lg" /></Button
        >
        <Button isLink={true} href="#_" size="lg" variant="default" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
        <Button isLink={true} href="#_" size="xl" variant="default" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
      </div>
    </div>
  </div>
  <!-- Accent -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Accent text
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="accent"
          >Accent XXS</Button
        >
        <Button isLink={true} href="#_" size="xs" variant="accent"
          >Accent XS</Button
        >
        <Button isLink={true} href="#_" size="sm" variant="accent"
          >Accent SM</Button
        >
        <Button isLink={true} href="#_" size="base" variant="accent"
          >Accent Base</Button
        >
        <Button isLink={true} href="#_" size="md" variant="accent"
          >Accent MD</Button
        >
        <Button isLink={true} href="#_" size="lg" variant="accent"
          >Accent LG</Button
        >
        <Button isLink={true} href="#_" size="xl" variant="accent"
          >Accent XL</Button
        >
      </div>
    </div>
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Icon
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="accent" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="xs" variant="accent" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="sm" variant="accent" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="base" variant="accent" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="md" variant="accent" iconOnly
          ><Plus slot="icon" size="lg" /></Button
        >
        <Button isLink={true} href="#_" size="lg" variant="accent" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
        <Button isLink={true} href="#_" size="xl" variant="accent" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
      </div>
    </div>
  </div>
  <!-- Muted -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Muted text
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="muted"
          >Muted XXS</Button
        >
        <Button isLink={true} href="#_" size="xs" variant="muted"
          >Muted XS</Button
        >
        <Button isLink={true} href="#_" size="sm" variant="muted"
          >Muted SM</Button
        >
        <Button isLink={true} href="#_" size="base" variant="muted"
          >Muted Base</Button
        >
        <Button isLink={true} href="#_" size="md" variant="muted"
          >Muted MD</Button
        >
        <Button isLink={true} href="#_" size="lg" variant="muted"
          >Muted LG</Button
        >
        <Button isLink={true} href="#_" size="xl" variant="muted"
          >Muted XL</Button
        >
      </div>
    </div>
    <div>
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase text-base-900"
      >
        Icon
      </Text>
      <div class="flex flex-col mt-2 gap-4">
        <Button isLink={true} href="#_" size="xxs" variant="muted" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="xs" variant="muted" iconOnly
          ><Plus slot="icon" size="sm" /></Button
        >
        <Button isLink={true} href="#_" size="sm" variant="muted" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="base" variant="muted" iconOnly
          ><Plus slot="icon" size="base" /></Button
        >
        <Button isLink={true} href="#_" size="md" variant="muted" iconOnly
          ><Plus slot="icon" size="lg" /></Button
        >
        <Button isLink={true} href="#_" size="lg" variant="muted" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
        <Button isLink={true} href="#_" size="xl" variant="muted" iconOnly
          ><Plus slot="icon" size="xl" /></Button
        >
      </div>
    </div>
  </div>
</div>
