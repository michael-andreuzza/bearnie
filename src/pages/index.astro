---
import { AstroSeo } from "@lexingtonthemes/seo";
// Assets
import Logo from "@/components/assets/Logo.astro";
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/button/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { siteConfig } from "@/config/site";

const canonical = `${siteConfig.url}${Astro.url.pathname}`;
---

<AstroSeo
  title="Bearnie - Build your own component library"
  description="50+ accessible, open source components for Astro and Tailwind CSS. Installed as source with one CLI command — customize, extend, and own the code."
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: "Bearnie - Build Your Own Component Library",
    description:
      "50+ accessible, open source components for Astro and Tailwind CSS. Installed as source with one CLI command — customize, extend, and own the code.",
    site_name: siteConfig.name,
    type: "website",
    locale: "en_US",
    images: [
      {
        url: siteConfig.ogImage,
        width: 1200,
        height: 630,
        alt: `${siteConfig.name} Open Graph image`,
        type: "image/png",
      },
    ],
  }}
  twitter={{
    cardType: "summary_large_image",
    site: siteConfig.author.twitter,
    handle: siteConfig.author.twitter,
  }}
/>
<BaseLayout
  showNavigation={false}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    description:
      "50+ accessible, open source components for Astro and Tailwind CSS. Installed as source with one CLI command — customize, extend, and own the code.",
    url: siteConfig.url,
    publisher: {
      "@type": "Organization",
      name: siteConfig.name,
      url: siteConfig.url,
      logo: {
        "@type": "ImageObject",
        url: siteConfig.ogImage,
      },
    },
    sameAs: [siteConfig.links.github],
  }}
>
  <section>
    <Wrapper
      class="standard"
      class="py-12 lg:h-[calc(100vh-15rem)] flex flex-col justify-center"
    >
      <!-- Hero Section -->
      <div class="max-w-sm text-center mx-auto text-balance">
        <Logo class="size-12 lg:size-20 mx-auto" />
        <Text
          tag="h1"
          variant="textXL"
          class="font-medium tracking-tight mt-12"
        >
          Astro components, <br /> installed as source
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground mt-4">
          50+ accessible components for Astro and Tailwind CSS, in any of 160+
          color palettes. One command copies the code into your project — yours
          to restyle, extend, and keep.
        </Text>

        <div class="flex items-center gap-2.5 mt-12 justify-center">
          <Button href="/docs" size="default">Get Started</Button>
          <Button href="/docs/components" variant="outline" size="default"
            >Browse Components</Button
          >
        </div>
        <button
          type="button"
          class="group mt-8 mx-auto flex items-center gap-2 rounded-md border border-border bg-muted/50 px-3 py-1.5 font-mono text-xs text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
          data-copy-init
          aria-label="Copy npx bearnie init to clipboard"
        >
          npx bearnie init
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5 opacity-50 group-hover:opacity-100 transition-opacity"
            aria-hidden="true"
            data-copy-icon
          >
            <rect width="14" height="14" x="8" y="8" rx="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5 hidden"
            aria-hidden="true"
            data-check-icon
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </button>
      </div>
    </Wrapper>
  </section>
  <script>
    function initCopyInit() {
      document.querySelectorAll("[data-copy-init]").forEach((button) => {
        if (button.hasAttribute("data-initialized")) return;
        button.setAttribute("data-initialized", "true");

        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText("npx bearnie init");
          const copyIcon = button.querySelector("[data-copy-icon]");
          const checkIcon = button.querySelector("[data-check-icon]");
          copyIcon?.classList.add("hidden");
          checkIcon?.classList.remove("hidden");
          setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            checkIcon?.classList.add("hidden");
          }, 1500);
        });
      });
    }

    initCopyInit();
    document.addEventListener("astro:page-load", initCopyInit);
  </script>
</BaseLayout>
