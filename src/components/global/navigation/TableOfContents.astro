---
import { Image } from "astro:assets";
import { sidebarAds } from "@/config/sidebar-ads";

export interface Props {
  contentId?: string;
}
const { contentId = "docs-content" } = Astro.props;
---

<aside
  class="hidden xl:flex flex-col shrink-0 lg:w-48 px-4 pt-8 pb-8 sticky top-0 self-start h-[calc(100vh-3.5rem)]"
>
  <!-- TOC - scrollable -->
  <div class="flex-1 min-h-0 overflow-y-auto scrollbar-hide pr-1 space-y-3">
    <p class="font-medium text-sm text-foreground">On this page</p>
    <nav class="text-sm relative" id="docs-toc" data-content-id={contentId}>
      <!-- TOC will be populated by JavaScript -->
    </nav>
  </div>

  <!-- Banner - fixed at bottom -->
  <div class="shrink-0 pt-6 space-y-4">
    {
      sidebarAds.map((ad) => (
        <a
          href={ad.href}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-lg transition-opacity hover:opacity-90"
        >
          <Image
            src={ad.image}
            alt={ad.alt}
            width={414}
            height={513}
            class="size-auto aspect-square object-cover"
          />
        </a>
      ))
    }
  </div>
</aside>

<script>
  function generateTOC() {
    const toc = document.getElementById("docs-toc");
    if (!toc || toc.hasAttribute("data-toc-initialized")) return;
    toc.setAttribute("data-toc-initialized", "true");

    const contentId = toc.getAttribute("data-content-id") || "docs-content";
    const content = document.getElementById(contentId);
    if (!content) return;

    const headings = Array.from(
      content.querySelectorAll<HTMLElement>("h2, h3, h4"),
    );
    if (headings.length === 0) {
      toc.innerHTML =
        '<p class="text-muted-foreground text-sm">No sections</p>';
      return;
    }

    const indentByLevel: Record<string, string> = {
      H2: "pl-3.5",
      H3: "pl-6",
      H4: "pl-8",
    };

    const tocList = document.createElement("ul");
    tocList.className = "relative border-l border-border";

    // Single indicator that slides to the active item
    const indicator = document.createElement("span");
    indicator.className =
      "absolute -left-px w-0.5 rounded-full bg-foreground opacity-0 transition-all duration-200 ease-out";
    indicator.setAttribute("aria-hidden", "true");
    tocList.appendChild(indicator);

    const linkById = new Map<string, HTMLAnchorElement>();

    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id =
          heading.textContent
            ?.toLowerCase()
            .replace(/\s+/g, "-")
            .replace(/[^\w-]/g, "") || `section-${index}`;
      }
      // Keep headings clear of the top blur when jumped to
      heading.style.scrollMarginTop = "1.5rem";

      const li = document.createElement("li");
      const link = document.createElement("a");
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent;
      link.className = `block py-1 ${indentByLevel[heading.tagName] || "pl-3.5"} text-xs leading-relaxed text-muted-foreground hover:text-foreground transition-colors`;
      link.addEventListener("click", () => setActive(heading.id));
      linkById.set(heading.id, link);
      li.appendChild(link);
      tocList.appendChild(li);
    });

    toc.appendChild(tocList);

    let activeId = "";

    function setActive(id: string) {
      if (id === activeId) return;
      activeId = id;

      linkById.forEach((link, linkId) => {
        const isActive = linkId === id;
        link.classList.toggle("text-foreground", isActive);
        link.classList.toggle("font-medium", isActive);
        link.classList.toggle("text-muted-foreground", !isActive);
      });

      const activeLink = linkById.get(id);
      if (activeLink) {
        indicator.style.top = `${activeLink.offsetTop + 5}px`;
        indicator.style.height = `${activeLink.offsetHeight - 10}px`;
        indicator.classList.remove("opacity-0");
      }
    }

    // Scroll spy: active section is the last heading above the reading line
    const scroller = content.closest(".scrollbar-styled");

    function updateActive() {
      const readingLine = 96;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= readingLine) {
          current = heading;
        } else {
          break;
        }
      }
      if (current) setActive(current.id);
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        updateActive();
      });
    }

    (scroller || window).addEventListener("scroll", onScroll, {
      passive: true,
    });
    updateActive();
  }

  generateTOC();
  document.addEventListener("astro:page-load", generateTOC);
</script>
