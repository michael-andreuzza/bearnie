---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Foundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import DocsSearch from "@/components/docs/DocsSearch.astro";
import ThemeToggle from "@/components/ui/theme-toggle/ThemeToggle.astro";
import LogoContextMenu from "@/components/global/LogoContextMenu.astro";
import { siteConfig } from "@/config/site";
export interface Props {
  variant?: "default" | "docs";
}
const { variant = "default" } = Astro.props;
// The docs header keeps only the essentials; these links show on the landing page
const navLinks = [
  { title: "Docs", href: "/docs" },
  {
    title: "Astro  themes",
    href: "https://lexingtonthemes.com/",
    external: true,
  },
];
const githubUrl = siteConfig.links.github;
const githubRepoSlug = new URL(githubUrl).pathname.slice(1);
---

{
  variant === "docs" ? (
    <header class="sticky top-0 z-50 w-full bg-background">
      <Wrapper variant="standard">
        <div class="flex py-4 items-center justify-between ">
          <LogoContextMenu>
            <a href="/" class="font-semibold flex items-center gap-2">
              <Logo class="size-4" />
              bearnie
            </a>
          </LogoContextMenu>
          <div class="hidden md:flex items-center gap-1">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 h-7 px-2 rounded-md text-sm text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
              aria-label="GitHub"
            >
              <svg
                viewBox="0 0 16 16"
                fill="currentColor"
                class="size-3.5"
                aria-hidden="true"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
              <span id="github-stars-docs" class="tabular-nums" />
            </a>
            <DocsSearch />
            <ThemeToggle size="xs" />
          </div>
          <div class="flex items-center gap-1 md:hidden">
            <DocsSearch />
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
              aria-label="GitHub"
            >
              <svg
                viewBox="0 0 16 16"
                fill="currentColor"
                class="size-4"
                aria-hidden="true"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
            <ThemeToggle size="xs" />
            <button
              type="button"
              class="inline-flex items-center justify-center size-7 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
              id="docs-mobile-menu-toggle"
              aria-label="Toggle menu"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="size-5"
                aria-hidden="true"
              >
                <path d="M4 9h16" />
                <path d="M4 15h16" />
              </svg>
            </button>
          </div>
        </div>
      </Wrapper>
    </header>
  ) : (
    <header class="sticky top-0 z-50 w-full bg-background">
      <Wrapper variant="standard">
        <div class="mx-auto flex py-4 items-center justify-between">
          <LogoContextMenu>
            <a href="/" class="font-semibold flex items-center gap-2">
              bearnie
            </a>
          </LogoContextMenu>
          <div class="flex items-center gap-4">
            <nav class="flex items-center gap-6 text-sm">
              {navLinks.map((Link01Icon) => (
                <a
                  href={Link01Icon.href}
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  {...(Link01Icon.external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {Link01Icon.title}
                </a>
              ))}
            </nav>
            <ThemeToggle size="xs" />
          </div>
        </div>
      </Wrapper>
    </header>
  )
}
<script define:vars={{ githubRepoSlug }}>
  // Fetch GitHub stars (cached so client-side navigation doesn't refetch)
  let cachedStars = null;

  async function fetchGitHubStars() {
    try {
      if (cachedStars === null) {
        const response = await fetch(
          `https://api.github.com/repos/${githubRepoSlug}`,
        );
        if (!response.ok) return;
        const data = await response.json();
        const stars = data.stargazers_count;
        cachedStars =
          stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : stars.toString();
      }
      const docsStars = document.getElementById("github-stars-docs");
      const defaultStars = document.getElementById("github-stars-default");
      if (docsStars) docsStars.textContent = cachedStars;
      if (defaultStars) defaultStars.textContent = cachedStars;
    } catch (error) {
      console.error("Failed to fetch GitHub stars:", error);
    }
  }
  fetchGitHubStars();
  document.addEventListener("astro:page-load", fetchGitHubStars);
</script>
