---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';
import HugeIcon from "../icon/HugeIcon.astro";
import { Loading03Icon } from "../icon/icons";

export interface Props extends HTMLAttributes<'svg'> {
  size?: 'sm' | 'default' | 'lg';
  /** Accessible loading announcement for screen readers */
  label?: string;
}

const {
  size = 'default',
  label = 'Loading',
  class: className,
  color,
  ...props
} = Astro.props;

const sizeStyles = {
  sm: 'size-4',
  default: 'size-6',
  lg: 'size-8',
};

const classes = cn(
  'animate-spin text-muted-foreground',
  sizeStyles[size],
  className
);
---

<span role="status" class="contents">
  <HugeIcon icon={Loading03Icon}
    class={classes}
    color={color ?? undefined}
    {...(props as Record<string, string | number | undefined>)}
  />
  <span class="sr-only">{label}</span>
</span>
