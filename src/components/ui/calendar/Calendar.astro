---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  /** "single" selects one date, "range" selects a from/to pair */
  mode?: "single" | "range";
  /** Number of months shown side by side (stacked on small screens) */
  months?: number;
  /** Preselected date (single mode), ISO format YYYY-MM-DD */
  defaultValue?: string;
  /** Preselected range start/end (range mode), ISO format YYYY-MM-DD */
  defaultFrom?: string;
  defaultTo?: string;
  /** Earliest/latest selectable date, ISO format YYYY-MM-DD */
  min?: string;
  max?: string;
  /** First day of the week: 0 = Sunday, 1 = Monday */
  weekStartsOn?: 0 | 1;
  /**
   * Form field name. Single mode renders one hidden input; range mode
   * renders `<name>-from` and `<name>-to`.
   */
  name?: string;
}

const {
  mode = "single",
  months = 1,
  defaultValue,
  defaultFrom,
  defaultTo,
  min,
  max,
  weekStartsOn = 1,
  name,
  class: className,
  ...props
} = Astro.props;

const classes = cn("relative w-fit rounded-lg border bg-background p-3", className);

const navButton =
  "absolute top-3 z-10 inline-flex size-7 items-center justify-center rounded-md border bg-background text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50";

const chevron = (d: string) =>
  `<svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${d}" /></svg>`;
---

<div
  class={classes}
  data-calendar
  data-mode={mode}
  data-months={months}
  data-default-value={defaultValue}
  data-default-from={defaultFrom}
  data-default-to={defaultTo}
  data-min={min}
  data-max={max}
  data-week-starts-on={weekStartsOn}
  {...props}
>
  <button
    type="button"
    data-calendar-prev
    aria-label="Previous month"
    class={cn(navButton, "left-3")}
    set:html={chevron("m15 18-6-6 6-6")}
  />
  <button
    type="button"
    data-calendar-next
    aria-label="Next month"
    class={cn(navButton, "right-3")}
    set:html={chevron("m9 18 6-6-6-6")}
  />
  <span class="sr-only" aria-live="polite" data-calendar-live></span>
  <div
    data-calendar-months
    class="flex flex-col gap-6 sm:flex-row"
  >
  </div>
  {name && mode === "single" && (
    <input type="hidden" name={name} value={defaultValue ?? ""} data-calendar-input />
  )}
  {name && mode === "range" && (
    <>
      <input type="hidden" name={`${name}-from`} value={defaultFrom ?? ""} data-calendar-input-from />
      <input type="hidden" name={`${name}-to`} value={defaultTo ?? ""} data-calendar-input-to />
    </>
  )}
</div>

<script>
  const DAY_BASE =
    "inline-flex size-8 items-center justify-center rounded-md text-sm font-normal transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";

  function parseISO(value: string | null | undefined): Date | null {
    if (!value) return null;
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
    if (!m) return null;
    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    return isNaN(d.getTime()) ? null : d;
  }

  function toISO(d: Date): string {
    const p = (n: number) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  }

  function sameDay(a: Date | null, b: Date | null): boolean {
    return !!a && !!b && a.getTime() === b.getTime();
  }

  function initCalendars() {
    document.querySelectorAll<HTMLElement>("[data-calendar]").forEach((root) => {
      if (root.hasAttribute("data-initialized")) return;
      root.setAttribute("data-initialized", "true");

      const mode = root.getAttribute("data-mode") === "range" ? "range" : "single";
      const monthCount = Math.max(1, Number(root.getAttribute("data-months")) || 1);
      const weekStartsOn = root.getAttribute("data-week-starts-on") === "0" ? 0 : 1;
      const min = parseISO(root.getAttribute("data-min"));
      const max = parseISO(root.getAttribute("data-max"));

      let selected = parseISO(root.getAttribute("data-default-value"));
      let from = parseISO(root.getAttribute("data-default-from"));
      let to = parseISO(root.getAttribute("data-default-to"));

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const initial = mode === "range" ? from : selected;
      // First visible month; up to monthCount - 1 more render after it
      let viewMonth = new Date(
        (initial ?? today).getFullYear(),
        (initial ?? today).getMonth(),
        1,
      );
      // Day that holds the roving tabindex (focus target for keyboard nav)
      let focusDate = initial ?? today;

      const monthsEl = root.querySelector("[data-calendar-months]") as HTMLElement;
      const liveEl = root.querySelector("[data-calendar-live]") as HTMLElement;
      const prevBtn = root.querySelector("[data-calendar-prev]") as HTMLButtonElement;
      const nextBtn = root.querySelector("[data-calendar-next]") as HTMLButtonElement;

      const monthStart = (offset: number) =>
        new Date(viewMonth.getFullYear(), viewMonth.getMonth() + offset, 1);

      const isDisabled = (d: Date) => (min && d < min) || (max && d > max);

      function dispatch() {
        const detail =
          mode === "range"
            ? { from: from ? toISO(from) : null, to: to ? toISO(to) : null }
            : { date: selected ? toISO(selected) : null };
        root.dispatchEvent(
          new CustomEvent("calendar-change", { bubbles: true, detail }),
        );
      }

      function syncInputs() {
        if (mode === "single") {
          const input = root.querySelector("[data-calendar-input]") as HTMLInputElement | null;
          if (input) input.value = selected ? toISO(selected) : "";
        } else {
          const inputFrom = root.querySelector("[data-calendar-input-from]") as HTMLInputElement | null;
          const inputTo = root.querySelector("[data-calendar-input-to]") as HTMLInputElement | null;
          if (inputFrom) inputFrom.value = from ? toISO(from) : "";
          if (inputTo) inputTo.value = to ? toISO(to) : "";
        }
      }

      function select(d: Date) {
        if (isDisabled(d)) return;
        if (mode === "single") {
          selected = sameDay(selected, d) ? null : d;
        } else if (!from || (from && to) || d < from) {
          from = d;
          to = null;
        } else {
          to = d;
        }
        focusDate = d;
        syncInputs();
        dispatch();
        // Re-render replaces the buttons; keep focus on the selected day
        render(document.activeElement instanceof HTMLElement &&
          monthsEl.contains(document.activeElement));
      }

      function firstVisible(monthDate: Date): Date {
        const first = new Date(monthDate);
        first.setDate(first.getDate() - ((first.getDay() - weekStartsOn + 7) % 7));
        return first;
      }

      function renderMonth(monthDate: Date, outsideClickable: boolean) {
        const block = document.createElement("div");

        const label = document.createElement("div");
        label.className = "flex h-7 items-center justify-center text-sm font-medium";
        label.textContent = monthDate.toLocaleDateString(undefined, {
          month: "long",
          year: "numeric",
        });
        block.appendChild(label);

        const grid = document.createElement("div");
        grid.setAttribute("role", "grid");
        grid.className = "mt-3";

        const headerRow = document.createElement("div");
        headerRow.setAttribute("role", "row");
        headerRow.className = "flex";
        for (let i = 0; i < 7; i++) {
          // 2024-01-01 is a Monday; +6 keeps the offset positive for weekStartsOn=0
          const day = new Date(2024, 0, 1 + ((i + weekStartsOn + 6) % 7));
          const cell = document.createElement("div");
          cell.setAttribute("role", "columnheader");
          cell.className =
            "flex size-8 items-center justify-center text-xs font-normal text-muted-foreground";
          cell.textContent = day.toLocaleDateString(undefined, { weekday: "narrow" });
          cell.setAttribute(
            "aria-label",
            day.toLocaleDateString(undefined, { weekday: "long" }),
          );
          headerRow.appendChild(cell);
        }
        grid.appendChild(headerRow);

        const first = firstVisible(monthDate);
        let focusTarget: HTMLButtonElement | null = null;

        for (let week = 0; week < 6; week++) {
          const row = document.createElement("div");
          row.setAttribute("role", "row");
          row.className = "flex";
          for (let i = 0; i < 7; i++) {
            const d = new Date(first);
            d.setDate(d.getDate() + week * 7 + i);
            const btn = document.createElement("button");
            btn.type = "button";
            btn.setAttribute("role", "gridcell");
            btn.setAttribute("data-calendar-day", toISO(d));
            btn.setAttribute(
              "aria-label",
              d.toLocaleDateString(undefined, {
                weekday: "long",
                month: "long",
                day: "numeric",
                year: "numeric",
              }),
            );
            btn.textContent = String(d.getDate());

            const outside = d.getMonth() !== monthDate.getMonth();
            // In multi-month view, hide outside days entirely so dates
            // never appear twice across adjacent grids
            if (outside && !outsideClickable) {
              btn.className = DAY_BASE + " invisible";
              btn.tabIndex = -1;
              btn.disabled = true;
              row.appendChild(btn);
              continue;
            }

            const isToday = sameDay(d, today);
            const isStart = mode === "range" ? sameDay(d, from) : sameDay(d, selected);
            const isEnd = mode === "range" && sameDay(d, to);
            const inRange =
              mode === "range" && from && to && d > from && d < to;

            let cls = DAY_BASE;
            if (isStart || isEnd) {
              cls +=
                " bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground";
              btn.setAttribute("aria-selected", "true");
            } else if (inRange) {
              cls += " rounded-none bg-accent text-accent-foreground";
              btn.setAttribute("aria-selected", "true");
            } else if (isToday) {
              cls += " bg-accent text-accent-foreground";
            } else if (outside) {
              cls += " text-muted-foreground opacity-50";
            }
            if (mode === "range" && isStart && to) cls += " rounded-r-none";
            if (mode === "range" && isEnd) cls += " rounded-l-none";
            btn.className = cls;

            if (isDisabled(d)) {
              btn.disabled = true;
              btn.classList.add("pointer-events-none", "opacity-30");
            }

            const focusable = sameDay(d, focusDate);
            btn.tabIndex = focusable ? 0 : -1;
            if (focusable) focusTarget = btn;

            btn.addEventListener("click", () => {
              if (outside) viewMonth = new Date(d.getFullYear(), d.getMonth(), 1);
              select(d);
            });

            row.appendChild(btn);
          }
          grid.appendChild(row);
        }

        block.appendChild(grid);
        return { block, focusTarget };
      }

      function render(focusAfter = false) {
        // Disable nav that would move entirely outside min/max
        prevBtn.disabled = !!(
          min && new Date(viewMonth.getFullYear(), viewMonth.getMonth(), 0) < min
        );
        nextBtn.disabled = !!(
          max && monthStart(monthCount) > max
        );

        // If the focused day isn't visible, park focus on the first month
        const visibleStart = firstVisible(viewMonth);
        const lastMonth = monthStart(monthCount - 1);
        const visibleEnd = new Date(firstVisible(lastMonth));
        visibleEnd.setDate(visibleEnd.getDate() + 41);
        if (focusDate < visibleStart || focusDate > visibleEnd) {
          focusDate = new Date(viewMonth);
        }
        // In multi-month view outside days are hidden, so clamp focus into
        // the months themselves
        if (monthCount > 1) {
          if (focusDate < viewMonth) focusDate = new Date(viewMonth);
          const end = new Date(monthStart(monthCount).getTime() - 86400000);
          if (focusDate > end) focusDate = end;
        }

        monthsEl.innerHTML = "";
        let focusTarget: HTMLButtonElement | null = null;
        const labels: string[] = [];

        for (let offset = 0; offset < monthCount; offset++) {
          const monthDate = monthStart(offset);
          labels.push(
            monthDate.toLocaleDateString(undefined, { month: "long", year: "numeric" }),
          );
          const { block, focusTarget: target } = renderMonth(
            monthDate,
            monthCount === 1,
          );
          monthsEl.appendChild(block);
          if (target) focusTarget = target;
        }

        liveEl.textContent = labels.join(" – ");
        if (focusAfter) focusTarget?.focus();
      }

      function moveFocus(days: number, months = 0) {
        const next = new Date(focusDate);
        if (months !== 0) next.setMonth(next.getMonth() + months);
        else next.setDate(next.getDate() + days);
        if ((min && next < min) || (max && next > max)) return;
        focusDate = next;
        // Shift the view only when focus leaves the visible months
        if (next < viewMonth) {
          viewMonth = new Date(next.getFullYear(), next.getMonth(), 1);
        } else if (next >= monthStart(monthCount)) {
          viewMonth = new Date(
            next.getFullYear(),
            next.getMonth() - (monthCount - 1),
            1,
          );
        }
        render(true);
      }

      monthsEl.addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        const handlers: Record<string, () => void> = {
          ArrowLeft: () => moveFocus(-1),
          ArrowRight: () => moveFocus(1),
          ArrowUp: () => moveFocus(-7),
          ArrowDown: () => moveFocus(7),
          PageUp: () => moveFocus(0, -1),
          PageDown: () => moveFocus(0, 1),
          Home: () => moveFocus(-((focusDate.getDay() - weekStartsOn + 7) % 7)),
          End: () => moveFocus(6 - ((focusDate.getDay() - weekStartsOn + 7) % 7)),
        };
        if (handlers[key]) {
          e.preventDefault();
          handlers[key]();
        } else if (key === "Enter" || key === " ") {
          e.preventDefault();
          select(new Date(focusDate));
        }
      });

      // Programmatic API: set the selection from outside (e.g. preset buttons)
      root.addEventListener("calendar-set", (e) => {
        const detail = ((e as CustomEvent).detail ?? {}) as {
          date?: string | null;
          from?: string | null;
          to?: string | null;
        };
        if (mode === "single") {
          selected = parseISO(detail.date);
          if (selected) focusDate = selected;
        } else {
          from = parseISO(detail.from);
          to = parseISO(detail.to);
          if (from && to && to < from) [from, to] = [to, from];
          if (from) focusDate = from;
        }
        const anchor = mode === "range" ? from : selected;
        if (anchor) {
          viewMonth = new Date(anchor.getFullYear(), anchor.getMonth(), 1);
          // If the range spans more months than are visible, keep the end in view
          if (mode === "range" && to) {
            const span =
              (to.getFullYear() - viewMonth.getFullYear()) * 12 +
              (to.getMonth() - viewMonth.getMonth());
            if (span >= monthCount) {
              viewMonth = new Date(
                to.getFullYear(),
                to.getMonth() - (monthCount - 1),
                1,
              );
            }
          }
        }
        syncInputs();
        dispatch();
        render();
      });

      prevBtn.addEventListener("click", () => {
        viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() - 1, 1);
        render();
      });
      nextBtn.addEventListener("click", () => {
        viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 1);
        render();
      });

      render();
    });
  }

  initCalendars();
  document.addEventListener("astro:page-load", initCalendars);
</script>
