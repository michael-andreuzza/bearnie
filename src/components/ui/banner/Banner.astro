---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  /**
   * Unique id. When set, dismissing the banner is remembered in
   * localStorage so it stays hidden on future page loads.
   */
  id?: string;
  dismissible?: boolean;
  variant?: "default" | "muted";
  /**
   * "static" renders in flow where placed; "top"/"bottom" pin the banner
   * to the viewport edge.
   */
  position?: "static" | "top" | "bottom";
  /** Detach from the edge: margins, rounded corners, and a shadow. */
  floating?: boolean;
  /**
   * Floating only. "stretch" spans the viewport width (minus margins);
   * "start"/"center"/"end" shrink the banner to its content and place it.
   */
  align?: "stretch" | "start" | "center" | "end";
}

const {
  id,
  dismissible = false,
  variant = "default",
  position = "static",
  floating = false,
  align = "stretch",
  class: className,
  ...props
} = Astro.props;

// Floating implies pinned; default to the bottom like most floating banners
const edge = floating && position === "static" ? "bottom" : position;

const positionClasses = floating
  ? cn(
      "fixed z-50 rounded-lg shadow-lg",
      edge === "top" ? "top-4" : "bottom-4",
      // w-auto: the width must come from inset-x-4, not the base w-full
      align === "stretch" && "inset-x-4 w-auto",
      align === "start" && "left-4 w-max max-w-[calc(100vw-2rem)]",
      align === "center" &&
        "left-1/2 w-max max-w-[calc(100vw-2rem)] -translate-x-1/2",
      align === "end" && "right-4 w-max max-w-[calc(100vw-2rem)]"
    )
  : cn(
      edge === "top" && "fixed inset-x-0 top-0 z-50",
      edge === "bottom" && "fixed inset-x-0 bottom-0 z-50"
    );

const classes = cn(
  "flex w-full flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2.5 text-sm",
  variant === "default" && "bg-primary text-primary-foreground",
  variant === "muted" && "bg-muted text-foreground",
  positionClasses,
  className
);
---

<div class={classes} data-banner data-banner-id={id} id={id} {...props}>
  {/* Runs before paint so returning visitors never see a dismissed banner flash */}
  <script is:inline>
    (() => {
      var s = document.currentScript;
      var el = s.parentElement;
      var id = el.getAttribute("data-banner-id");
      try {
        if (id && localStorage.getItem("bearnie-banner-" + id) === "dismissed") {
          el.hidden = true;
        }
      } catch (e) {}
      s.remove();
    })();
  </script>
  <div
    class={cn(
      "flex flex-1 flex-wrap items-center gap-x-3 gap-y-1",
      // Shrink-to-fit floating banners read better left-aligned
      floating && align !== "stretch" ? "justify-start" : "justify-center"
    )}
  >
    <slot />
  </div>
  {
    Astro.slots.has("actions") && (
      <div
        class={cn(
          "flex shrink-0 items-center gap-2",
          // Corner notices read like a card: actions go on their own row
          floating && (align === "start" || align === "end") && "basis-full"
        )}
      >
        <slot name="actions" />
      </div>
    )
  }
  {
    dismissible && (
      <button
        type="button"
        class="shrink-0 rounded-md p-1 opacity-70 transition-opacity hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current"
        data-banner-dismiss
        aria-label="Dismiss banner"
      >
        <svg
          class="size-4"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    )
  }
</div>

<script>
  function initBanners() {
    document.querySelectorAll("[data-banner]").forEach((banner) => {
      if (banner.hasAttribute("data-initialized")) return;
      banner.setAttribute("data-initialized", "true");

      banner
        .querySelector("[data-banner-dismiss]")
        ?.addEventListener("click", () => {
          (banner as HTMLElement).hidden = true;
          const id = banner.getAttribute("data-banner-id");
          if (id) {
            try {
              localStorage.setItem(`bearnie-banner-${id}`, "dismissed");
            } catch {
              // Private browsing: dismissal just won't persist
            }
          }
          banner.dispatchEvent(
            new CustomEvent("banner-dismiss", { bubbles: true })
          );
        });
    });
  }

  initBanners();
  document.addEventListener("astro:page-load", initBanners);
</script>
