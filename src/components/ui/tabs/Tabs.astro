---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  defaultValue?: string;
  orientation?: "horizontal" | "vertical";
  /**
   * Sync the active tab with a URL search param of this name, so the
   * selected tab survives reloads and can be shared as a link.
   */
  syncKey?: string;
}

const {
  defaultValue,
  orientation = "horizontal",
  syncKey,
  class: className,
  ...props
} = Astro.props;

const classes = cn(
  "w-full",
  orientation === "vertical" && "grid grid-cols-1 lg:grid-cols-2 gap-4",
  className
);
---

<div
  class={classes}
  data-tabs
  data-default-value={defaultValue}
  data-orientation={orientation}
  data-sync-key={syncKey}
  {...props}
>
  <slot />
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initTabs } from "@/utils/runtime/tabs";

  registerUiInit(initTabs);
</script>
