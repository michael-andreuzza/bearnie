---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const {
  class: className,
  ...props
} = Astro.props;
---

<div data-dialog class={className} {...props}>
  <slot />
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initDialogs } from "@/utils/runtime/dialog";

  registerUiInit(initDialogs);
</script>
