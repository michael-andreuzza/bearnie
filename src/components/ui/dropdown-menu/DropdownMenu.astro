---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  /** When true, selecting an item does not close the menu (e.g. color pickers). */
  keepOpen?: boolean;
}

const { class: className, keepOpen = false, ...props } = Astro.props;
---

<div
  class={cn('relative inline-block text-left', className)}
  data-dropdown
  data-dropdown-keep-open={keepOpen ? 'true' : undefined}
  {...props}
>
  <slot />
</div>

<script>
  import { ensureUiBootLoaded } from "@/utils/runtime/loader";

  ensureUiBootLoaded();
</script>
