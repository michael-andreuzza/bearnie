---
import Button, { type Props as ButtonProps } from '@/components/ui/button/Button.astro';

export interface Props extends Omit<ButtonProps, 'href'> {}

const {
  // These attributes belong to the dropdown runtime and must not be overridden.
  'aria-expanded': _expanded,
  'aria-controls': _controls,
  'aria-haspopup': _haspopup,
  'data-dropdown-trigger': _trigger,
  'data-state': _state,
  ...props
} = Astro.props;
---

<Button
  {...props}
  type="button"
  data-dropdown-trigger
  data-state="closed"
  aria-expanded="false"
  aria-haspopup="menu"
>
  <slot name="left-icon" slot="left-icon" />
  <slot />
  <slot name="right-icon" slot="right-icon" />
</Button>
