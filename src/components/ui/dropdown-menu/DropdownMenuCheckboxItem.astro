---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'button'> {
  checked?: boolean;
  disabled?: boolean;
}

const { checked = false, disabled = false, class: className, ...props } = Astro.props;

const classes = cn(
  'relative flex w-full cursor-pointer select-none items-center rounded-sm py-1.5 pl-8 pr-2 text-left text-sm outline-none transition-colors',
  'focus:bg-accent focus:text-accent-foreground',
  'hover:bg-accent hover:text-accent-foreground',
  disabled && 'pointer-events-none opacity-50',
  className
);
---

<button
  type="button"
  class={classes}
  role="menuitemcheckbox"
  disabled={disabled}
  tabindex="-1"
  data-dropdown-item
  data-dropdown-checkbox-item
  data-checked={checked ? 'true' : 'false'}
  aria-checked={checked}
  {...props}
>
  <span class="absolute left-2 flex size-3.5 items-center justify-center">
    <svg
      class:list={['size-4', !checked && 'hidden']}
      aria-hidden="true"
      data-check-icon
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </span>
  <slot />
</button>
