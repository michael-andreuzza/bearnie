---
import type { HTMLAttributes } from 'astro/types';
import Button from '../button/Button.astro';

export interface Props extends HTMLAttributes<'button'> {
  variant?: "default" | "destructive";
  disabled?: boolean;
}

const {
  variant = "default",
  class: className,
  disabled = false,
  type = "button",
  ...props
} = Astro.props;
---

<Button
  variant={variant}
  size="sm"
  class={className}
  disabled={disabled}
  type={type}
  data-alert-dialog-action
  {...props}
>
  <slot />
</Button>
