---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...props } = Astro.props;
---

<div data-alert-dialog class={className} {...props}>
  <slot />
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initAlertDialogs } from "@/utils/runtime/alert-dialog";

  registerUiInit(initAlertDialogs);
</script>
