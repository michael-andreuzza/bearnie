---
import type { HTMLAttributes } from 'astro/types';
import Button from '../button/Button.astro';

export interface Props extends HTMLAttributes<'button'> {
  disabled?: boolean;
}

const {
  class: className,
  disabled = false,
  type = "button",
  ...props
} = Astro.props;
---

<Button
  variant="outline"
  size="sm"
  class={className}
  disabled={disabled}
  type={type}
  data-alert-dialog-cancel
  {...props}
>
  <slot />
</Button>
