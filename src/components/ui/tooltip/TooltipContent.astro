---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  side?: "top" | "right" | "bottom" | "left";
  id?: string;
}

const { side = "top", class: className, id, ...props } = Astro.props;

const classes = cn(
  "z-50 overflow-hidden rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md whitespace-nowrap",
  className,
);
---

<div
  class={classes}
  data-tooltip-content
  data-side={side}
  role="tooltip"
  id={id}
  hidden
  {...props}
>
  <slot />
</div>
