---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"aside"> {
  side?: "left" | "right";
  /**
   * true: collapses off-canvas (width 0). "icon": collapses to a 3rem icon
   * rail on desktop (labels hidden). false: cannot collapse.
   */
  collapsible?: boolean | "icon";
  defaultOpen?: boolean;
  /**
   * localStorage key. When set, the open/collapsed state survives page
   * loads (desktop only; mobile always starts closed).
   */
  persist?: string;
}

const {
  side = "left",
  collapsible = true,
  defaultOpen = true,
  persist,
  class: className,
  ...props
} = Astro.props;

const classes = cn(
  "flex h-full w-64 flex-col bg-sidebar text-sidebar-foreground border-sidebar-border",
  side === "left" ? "border-r" : "border-l",
  className
);
---

<aside
  class={classes}
  data-sidebar
  data-side={side}
  data-state={defaultOpen ? "open" : "closed"}
  data-collapsible={collapsible === "icon" ? "icon" : collapsible ? "true" : "false"}
  data-persist={persist}
  {...props}
>
  <slot />
</aside>

<script>
  // Handle responsive behavior
  function checkMobile(sidebar: Element) {
    const isMobile = window.innerWidth < 768;
    sidebar.setAttribute("data-mobile", isMobile ? "true" : "false");

    // On mobile, sidebar starts closed
    if (isMobile && sidebar.getAttribute("data-state") === "open") {
      sidebar.setAttribute("data-state", "closed");
    }
  }

  // Single resize listener, bound once; resolves live sidebars at event
  // time so listeners don't accumulate across view-transition navigations.
  let resizeListenerBound = false;

  function bindResizeListener() {
    if (resizeListenerBound) return;
    resizeListenerBound = true;
    window.addEventListener("resize", () => {
      document.querySelectorAll("[data-sidebar]").forEach(checkMobile);
    });
  }

  function initSidebars() {
    bindResizeListener();

    document.querySelectorAll("[data-sidebar]").forEach((sidebar) => {
      if (sidebar.hasAttribute("data-initialized")) return;
      sidebar.setAttribute("data-initialized", "true");
      checkMobile(sidebar);

      // Restore persisted state (desktop only; mobile always starts closed)
      const persistKey = sidebar.getAttribute("data-persist");
      if (persistKey && sidebar.getAttribute("data-mobile") !== "true") {
        const stored = localStorage.getItem(persistKey);
        if (stored === "open" || stored === "closed") {
          sidebar.setAttribute("data-state", stored);
        }
      }

      // Save state on toggle (only desktop states are worth restoring)
      if (persistKey) {
        sidebar.addEventListener("sidebar-toggle", () => {
          if (sidebar.getAttribute("data-mobile") === "true") return;
          localStorage.setItem(
            persistKey,
            sidebar.getAttribute("data-state") === "open" ? "open" : "closed"
          );
        });
      }

      // Backdrop behind the sidebar when it overlays content on mobile
      const backdrop = document.createElement("div");
      backdrop.setAttribute("data-sidebar-backdrop", "");
      backdrop.setAttribute("aria-hidden", "true");
      backdrop.hidden = true;
      sidebar.insertAdjacentElement("beforebegin", backdrop);
      backdrop.addEventListener("click", () => {
        sidebar.setAttribute("data-state", "closed");
        sidebar.dispatchEvent(
          new CustomEvent("sidebar-toggle", { detail: { open: false } })
        );
      });

      const syncBackdrop = () => {
        backdrop.hidden = !(
          sidebar.getAttribute("data-mobile") === "true" &&
          sidebar.getAttribute("data-state") === "open"
        );
      };
      syncBackdrop();
      new MutationObserver(syncBackdrop).observe(sidebar, {
        attributes: true,
        attributeFilter: ["data-state", "data-mobile"],
      });
    });
  }

  initSidebars();
  document.addEventListener("astro:page-load", initSidebars);
</script>

<style>
  [data-sidebar] {
    transition: width 0.2s ease-in-out, transform 0.2s ease-in-out;
  }

  [data-sidebar][data-state="closed"][data-collapsible="true"] {
    width: 0;
    overflow: hidden;
  }

  :global([data-sidebar-backdrop]) {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(0 0 0 / 0.5);
  }

  /* Icon rail: on desktop, collapsing keeps a narrow strip of icons */
  @media (min-width: 768px) {
    [data-sidebar][data-state="closed"][data-collapsible="icon"] {
      width: 3rem;
      overflow: hidden;
    }

    [data-sidebar][data-state="closed"][data-collapsible="icon"]
      :global([data-sidebar-group-label]),
    [data-sidebar][data-state="closed"][data-collapsible="icon"]
      :global([data-sidebar-menu-button] span) {
      display: none;
    }

    [data-sidebar][data-state="closed"][data-collapsible="icon"]
      :global([data-sidebar-menu-button]) {
      justify-content: center;
    }
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    [data-sidebar] {
      position: fixed;
      top: 0;
      bottom: 0;
      z-index: 50;
    }

    [data-sidebar][data-side="left"] {
      left: 0;
    }

    [data-sidebar][data-side="right"] {
      right: 0;
    }

    [data-sidebar][data-state="closed"] {
      transform: translateX(-100%);
    }

    [data-sidebar][data-side="right"][data-state="closed"] {
      transform: translateX(100%);
    }
  }
</style>
