---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils/cn";
import Button from "../button/Button.astro";

export interface Props extends HTMLAttributes<"div"> {
  size?: "xs" | "sm" | "default" | "lg";
}

const { size = "default", class: className, ...props } = Astro.props;

const options = [
  { mode: "light", label: "Light" },
  { mode: "dark", label: "Dark" },
  { mode: "system", label: "System" },
] as const;
---

<div class={cn("relative inline-block", className)} data-theme-toggle {...props}>
  <Button
    variant="ghost"
    size={size}
    iconOnly
    data-theme-toggle-trigger
    aria-label="Change theme"
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <!-- Sun: light -->
    <svg
      data-theme-icon="light"
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <!-- Moon: dark -->
    <svg
      data-theme-icon="dark"
      class="size-4 hidden"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
    <!-- Monitor: system -->
    <svg
      data-theme-icon="system"
      class="size-4 hidden"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="20" height="14" x="2" y="3" rx="2"></rect>
      <path d="M8 21h8"></path>
      <path d="M12 17v4"></path>
    </svg>
  </Button>
  <div
    data-theme-menu
    hidden
    role="menu"
    class="absolute right-0 top-full z-50 mt-1 w-32 rounded-md border border-border bg-popover p-1 shadow-md"
  >
    {
      options.map((option) => (
        <button
          type="button"
          role="menuitemradio"
          data-theme-option={option.mode}
          class="flex w-full items-center justify-between rounded-sm px-2 py-1.5 text-sm text-popover-foreground hover:bg-accent hover:text-accent-foreground transition-colors cursor-pointer"
        >
          {option.label}
          <svg
            data-theme-check
            class="size-3.5 hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </button>
      ))
    }
  </div>
</div>

<script is:inline>
  // Apply the stored theme before paint to prevent a flash. "system" follows
  // the OS preference, including live changes while the page is open.
  (function () {
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const applyTheme = () => {
      const mode = localStorage.getItem("theme") || "system";
      const dark = mode === "system" ? media.matches : mode === "dark";
      document.documentElement.classList.toggle("dark", dark);
    };
    applyTheme();
    // View transitions replace <html> attributes, so re-apply after each swap
    document.addEventListener("astro:after-swap", applyTheme);
    media.addEventListener("change", () => {
      if ((localStorage.getItem("theme") || "system") === "system") applyTheme();
    });
  })();
</script>

<script>
  const MODES = ["light", "dark", "system"] as const;
  type Mode = (typeof MODES)[number];

  const media = window.matchMedia("(prefers-color-scheme: dark)");

  const currentMode = (): Mode => {
    const stored = localStorage.getItem("theme");
    return (MODES as readonly string[]).includes(stored ?? "")
      ? (stored as Mode)
      : "system";
  };

  const applyMode = (mode: Mode) => {
    const dark = mode === "system" ? media.matches : mode === "dark";
    document.documentElement.classList.toggle("dark", dark);
  };

  const updateToggles = () => {
    const mode = currentMode();
    document.querySelectorAll("[data-theme-toggle]").forEach((root) => {
      root.querySelectorAll("[data-theme-icon]").forEach((icon) => {
        icon.classList.toggle(
          "hidden",
          icon.getAttribute("data-theme-icon") !== mode,
        );
      });
      root.querySelectorAll("[data-theme-option]").forEach((option) => {
        const active = option.getAttribute("data-theme-option") === mode;
        option.setAttribute("aria-checked", String(active));
        option
          .querySelector("[data-theme-check]")
          ?.classList.toggle("hidden", !active);
      });
    });
  };

  const closeMenu = (root: Element, restoreFocus = false) => {
    const menu = root.querySelector("[data-theme-menu]") as HTMLElement | null;
    const wasOpen = menu ? !menu.hidden : false;
    if (menu) menu.hidden = true;
    const trigger = root.querySelector(
      "[data-theme-toggle-trigger]",
    ) as HTMLElement | null;
    trigger?.setAttribute("aria-expanded", "false");
    if (restoreFocus && wasOpen) trigger?.focus();
  };

  const closeAllMenus = (restoreFocus = false) => {
    document
      .querySelectorAll("[data-theme-toggle]")
      .forEach((root) => closeMenu(root, restoreFocus));
  };

  // Bound once; resolves live elements at event time so it survives
  // view-transition navigations without leaking listeners.
  let documentListenersBound = false;
  const bindDocumentListeners = () => {
    if (documentListenersBound) return;
    documentListenersBound = true;

    document.addEventListener("click", (e) => {
      document.querySelectorAll("[data-theme-toggle]").forEach((root) => {
        if (!root.contains(e.target as Node)) closeMenu(root);
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAllMenus(true);
    });
  };

  const init = () => {
    bindDocumentListeners();
    updateToggles();

    document.querySelectorAll("[data-theme-toggle]").forEach((root) => {
      if (root.hasAttribute("data-initialized")) return;
      root.setAttribute("data-initialized", "true");

      const trigger = root.querySelector("[data-theme-toggle-trigger]");
      const menu = root.querySelector("[data-theme-menu]") as HTMLElement | null;
      if (!trigger || !menu) return;

      trigger.addEventListener("click", () => {
        const open = menu.hidden;
        closeAllMenus();
        menu.hidden = !open;
        trigger.setAttribute("aria-expanded", String(open));
        if (open) {
          const options = Array.from(
            root.querySelectorAll("[data-theme-option]"),
          ) as HTMLElement[];
          const active = options.find(
            (o) => o.getAttribute("data-theme-option") === currentMode(),
          );
          (active ?? options[0])?.focus();
        }
      });

      // Arrow-key navigation, matching the other role="menu" components
      menu.addEventListener("keydown", (e) => {
        const options = Array.from(
          root.querySelectorAll("[data-theme-option]"),
        ) as HTMLElement[];
        if (options.length === 0) return;
        const currentIndex = options.indexOf(
          document.activeElement as HTMLElement,
        );

        if (e.key === "ArrowDown") {
          e.preventDefault();
          options[(currentIndex + 1) % options.length]?.focus();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          options[
            currentIndex > 0 ? currentIndex - 1 : options.length - 1
          ]?.focus();
        } else if (e.key === "Home") {
          e.preventDefault();
          options[0]?.focus();
        } else if (e.key === "End") {
          e.preventDefault();
          options[options.length - 1]?.focus();
        }
      });

      root.querySelectorAll("[data-theme-option]").forEach((option) => {
        option.addEventListener("click", () => {
          const mode = option.getAttribute("data-theme-option") as Mode;
          localStorage.setItem("theme", mode);
          applyMode(mode);
          updateToggles();
          closeMenu(root, true);
        });
      });
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
