---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...props } = Astro.props;
---

<div class={cn('relative inline-block', className)} data-popover {...props}>
  <slot />
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initPopovers } from "@/utils/runtime/popover";
  import { initDisclosureTriggers } from "@/utils/runtime/disclosure-triggers";

  registerUiInit(initPopovers);
  registerUiInit(initDisclosureTriggers);
</script>
