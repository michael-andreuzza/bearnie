---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  /** Image shown on the left of the handle */
  before: string;
  /** Image shown on the right of the handle */
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  /** Initial handle position, 0–100 */
  defaultPosition?: number;
}

const {
  before,
  after,
  beforeAlt = "Before",
  afterAlt = "After",
  defaultPosition = 50,
  class: className,
  ...props
} = Astro.props;

const position = Math.min(100, Math.max(0, defaultPosition));

const classes = cn(
  "group relative w-full select-none overflow-hidden rounded-lg border",
  className,
);
---

<div
  class={classes}
  data-image-compare
  style={`--position: ${position}%`}
  {...props}
>
  <img src={after} alt={afterAlt} class="block w-full" draggable="false" />
  <img
    src={before}
    alt={beforeAlt}
    draggable="false"
    class="absolute inset-0 size-full object-cover"
    style="clip-path: inset(0 calc(100% - var(--position)) 0 0)"
    data-image-compare-before
  />
  <div
    class="absolute inset-y-0 w-px -translate-x-1/2 bg-white/80 shadow-[0_0_8px_rgba(0,0,0,0.3)]"
    style="left: var(--position)"
    aria-hidden="true"
  ></div>
  <button
    type="button"
    role="slider"
    aria-label="Compare images"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={position}
    data-image-compare-handle
    class="absolute top-1/2 flex size-8 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize items-center justify-center rounded-full border bg-background text-muted-foreground shadow-md transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:scale-95"
    style="left: var(--position)"
  >
    <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 8-4 4 4 4M15 8l4 4-4 4" /></svg>
  </button>
</div>

<script>
  function initImageCompares() {
    document.querySelectorAll<HTMLElement>("[data-image-compare]").forEach((root) => {
      if (root.hasAttribute("data-initialized")) return;
      root.setAttribute("data-initialized", "true");

      const handle = root.querySelector("[data-image-compare-handle]") as HTMLElement;

      function setPosition(percent: number) {
        const clamped = Math.min(100, Math.max(0, percent));
        root.style.setProperty("--position", `${clamped}%`);
        handle.setAttribute("aria-valuenow", String(Math.round(clamped)));
      }

      function positionFromEvent(e: PointerEvent) {
        const rect = root.getBoundingClientRect();
        setPosition(((e.clientX - rect.left) / rect.width) * 100);
      }

      let dragging = false;

      root.addEventListener("pointerdown", (e) => {
        dragging = true;
        root.setPointerCapture(e.pointerId);
        positionFromEvent(e);
      });
      root.addEventListener("pointermove", (e) => {
        if (dragging) positionFromEvent(e);
      });
      root.addEventListener("pointerup", () => {
        dragging = false;
      });
      root.addEventListener("pointercancel", () => {
        dragging = false;
      });

      handle.addEventListener("keydown", (e) => {
        const current = Number(handle.getAttribute("aria-valuenow")) || 0;
        const step = e.shiftKey ? 10 : 2;
        if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
          e.preventDefault();
          setPosition(current - step);
        } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
          e.preventDefault();
          setPosition(current + step);
        } else if (e.key === "Home") {
          e.preventDefault();
          setPosition(0);
        } else if (e.key === "End") {
          e.preventDefault();
          setPosition(100);
        }
      });
    });
  }

  initImageCompares();
  document.addEventListener("astro:page-load", initImageCompares);
</script>
