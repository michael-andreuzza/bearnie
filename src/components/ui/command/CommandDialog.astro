---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {}

const { class: className, ...props } = Astro.props;
---

<div data-command-dialog class={className} {...props}>
  <slot />
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initCommands, initCommandDialogs } from "@/utils/runtime/command";

  registerUiInit(initCommands);
  registerUiInit(initCommandDialogs);
</script>
