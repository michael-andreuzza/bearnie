---
import HugeIcon from "../icon/HugeIcon.astro";
import { ArrowDown01Icon } from "../icon/icons";
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"button"> {
  placeholder?: string;
  disabled?: boolean;
  inputGroupControl?: boolean;
}

const {
  placeholder = "Select an option",
  disabled = false,
  inputGroupControl = false,
  class: className,
  ...props
} = Astro.props;
---

{/*
  The button itself is the popover trigger, and the clear control renders
  as a sibling — nesting interactive elements inside a button is invalid.
*/}
<div class="relative w-full">
  <button
    type="button"
    class={cn(
      "flex h-10 w-full items-center justify-between rounded-md border bg-background px-3 py-2 text-sm",
      "border-input focus:ring-ring",
      "ring-offset-background placeholder:text-muted-foreground",
      "focus:outline-none focus:ring-2 focus:ring-offset-2",
      "disabled:cursor-not-allowed disabled:opacity-50",
      inputGroupControl &&
        "rounded-none border-0 bg-transparent px-3 focus:ring-0 focus:ring-offset-0",
      className
    )}
    data-popover-trigger
    data-combobox-trigger
    data-slot={inputGroupControl ? "input-group-control" : undefined}
    disabled={disabled}
    {...props}
  >
    <span class="truncate text-left" data-combobox-value>{placeholder}</span>
    <slot name="right-icon">
      <HugeIcon
        icon={ArrowDown01Icon}
        size="sm"
        class="text-muted-foreground"
        data-combobox-chevron
        aria-hidden="true"
      />
    </slot>
  </button>
  <span class="absolute right-8 top-1/2 flex -translate-y-1/2 items-center">
    <slot name="clear-icon" />
  </span>
</div>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initComboboxes } from "@/utils/runtime/combobox";
  import { initPopovers } from "@/utils/runtime/popover";

  registerUiInit(initPopovers);
  registerUiInit(initComboboxes);
</script>
