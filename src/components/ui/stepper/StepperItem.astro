---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  step: number;
}

const { step, class: className, ...props } = Astro.props;

const classes = cn(
  // min-w-0 (here and on children other than the circle trigger) lets items
  // shrink so long titles/descriptions wrap instead of overflowing the row
  'stepper-item flex min-w-0 items-center gap-2',
  '[&>:not([data-stepper-trigger])]:min-w-0',
  className
);
---

<div
  class={classes}
  data-stepper-item
  data-step={step}
  data-state="upcoming"
  {...props}
>
  <slot />
</div>
