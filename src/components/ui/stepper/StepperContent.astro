---
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  /** Which step this panel belongs to (matches StepperItem's step). */
  step: number;
}

const { step, class: className, ...props } = Astro.props;

const classes = cn(
  'mt-4',
  className
);
---

<div class={classes} data-stepper-content data-step={step} hidden {...props}>
  <slot />
</div>
