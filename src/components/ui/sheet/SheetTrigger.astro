---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"span"> {}

const { class: className, ...props } = Astro.props;
---

<span
  data-sheet-trigger
  class={cn("inline-block cursor-pointer", className)}
  role="button"
  tabindex="0"
  {...props}
>
  <slot />
</span>

<script>
  import { registerUiInit } from "@/utils/runtime/loader";
  import { initDisclosureTriggers } from "@/utils/runtime/disclosure-triggers";

  registerUiInit(initDisclosureTriggers);
</script>
