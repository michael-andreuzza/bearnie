---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...props } = Astro.props;

const classes = cn(
  // w-max: absolutely-positioned panels shrink-to-fit against the parent
  // menu's width, which would wrap long labels
  "absolute left-full top-0 z-50 ml-1 w-max min-w-[8rem] rounded-md border bg-popover p-1 text-popover-foreground shadow-md",
  className
);
---

<div class={classes} data-context-menu-sub-content role="menu" hidden {...props}>
  <slot />
</div>
