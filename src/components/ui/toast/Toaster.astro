---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  position?:
    | "top-left"
    | "top-center"
    | "top-right"
    | "bottom-left"
    | "bottom-center"
    | "bottom-right";
  /** Maximum number of toasts shown at once; the oldest is dismissed when exceeded. */
  max?: number;
}

const {
  position = "bottom-right",
  max = 5,
  class: className,
  ...props
} = Astro.props;

const positionStyles = {
  "top-left": "top-4 left-4",
  "top-center": "top-4 left-1/2 -translate-x-1/2",
  "top-right": "top-4 right-4",
  "bottom-left": "bottom-4 left-4",
  "bottom-center": "bottom-4 left-1/2 -translate-x-1/2",
  "bottom-right": "bottom-4 right-4",
};

const classes = cn(
  "fixed z-50 flex flex-col gap-2 w-full max-w-sm pointer-events-none",
  positionStyles[position],
  className
);
---

<div
  id="toaster"
  class={classes}
  data-toaster
  data-position={position}
  data-max-toasts={max}
  {...props}
>
</div>

<script>
  // Toast types — "destructive" matches the variant vocabulary used across
  // the library (Button, Badge, Alert).
  type ToastType = "default" | "success" | "destructive" | "warning" | "info" | "loading";

  interface ToastOptions {
    title?: string;
    description?: string;
    type?: ToastType;
    duration?: number;
    action?: {
      label: string;
      onClick: () => void;
    };
  }

  type ToastMessage = Omit<ToastOptions, "type"> | string;

  interface ToastPromiseMessages<T> {
    loading: ToastMessage;
    success: ToastMessage | ((value: T) => ToastMessage);
    error: ToastMessage | ((reason: unknown) => ToastMessage);
  }

  // Toast manager
  class ToastManager {
    // Looked up lazily so it stays valid after client-side navigation
    private get container(): HTMLElement | null {
      return document.getElementById("toaster");
    }

    private getIcon(type: ToastType): string {
      const icons = {
        default: "",
        loading: `<svg class="size-5 shrink-0 animate-spin text-muted-foreground" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>`,
        success: `<svg class="size-5 text-success shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`,
        destructive: `<svg class="size-5 text-destructive shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`,
        warning: `<svg class="size-5 text-warning shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
        info: `<svg class="size-5 text-info shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
      };
      return icons[type] || icons.default;
    }

    // Per-toast auto-dismiss timers so hover can pause and resume them
    private timers = new WeakMap<
      HTMLElement,
      { id: number; startedAt: number; remaining: number }
    >();

    private renderContent(toast: HTMLElement, opts: ToastOptions) {
      const { title, description, type = "default", action } = opts;

      // Static markup only — user-provided strings are added via
      // textContent below so they can't inject HTML.
      toast.innerHTML = `
        ${type !== "default" ? this.getIcon(type) : ""}
        <div class="flex-1 space-y-1" data-toast-body></div>
        <button type="button" class="absolute right-2 top-2 rounded-md p-1 text-foreground/50 opacity-0 transition-opacity hover:text-foreground focus:opacity-100 focus:outline-none group-hover:opacity-100 hover:opacity-100" data-toast-close aria-label="Dismiss notification">
          <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      `;

      const body = toast.querySelector("[data-toast-body]") as HTMLElement;
      if (title) {
        const titleEl = document.createElement("p");
        titleEl.className = "text-sm font-semibold";
        titleEl.textContent = title;
        body.appendChild(titleEl);
      }
      if (description) {
        const descEl = document.createElement("p");
        descEl.className = "text-sm text-muted-foreground";
        descEl.textContent = description;
        body.appendChild(descEl);
      }
      if (action) {
        const actionBtn = document.createElement("button");
        actionBtn.type = "button";
        actionBtn.className =
          "mt-2 text-sm font-medium underline underline-offset-4 hover:no-underline";
        actionBtn.textContent = action.label;
        actionBtn.addEventListener("click", () => {
          action.onClick();
          this.dismiss(toast);
        });
        body.appendChild(actionBtn);
      }

      const closeBtn = toast.querySelector("[data-toast-close]");
      closeBtn?.addEventListener("click", () => this.dismiss(toast));
    }

    private startTimer(toast: HTMLElement, duration: number) {
      this.clearTimer(toast);
      if (duration <= 0) return;
      const id = window.setTimeout(() => this.dismiss(toast), duration);
      this.timers.set(toast, { id, startedAt: Date.now(), remaining: duration });
    }

    private clearTimer(toast: HTMLElement) {
      const timer = this.timers.get(toast);
      if (timer) window.clearTimeout(timer.id);
    }

    show(options: ToastOptions | string) {
      const container = this.container;
      if (!container) return;

      const opts: ToastOptions =
        typeof options === "string" ? { description: options } : options;
      const { duration = 4000 } = opts;

      const toast = document.createElement("div");
      toast.className =
        "group pointer-events-auto relative flex w-full items-start gap-3 overflow-hidden rounded-lg border bg-background p-4 shadow-lg transition-all duration-200";
      toast.setAttribute("role", "alert");

      this.renderContent(toast, opts);

      // Enforce the stack limit by dismissing the oldest toast(s)
      const max = Number(container.getAttribute("data-max-toasts")) || 5;
      const existing = container.querySelectorAll("[data-toast]");
      for (let i = 0; i <= existing.length - max; i++) {
        this.dismiss(existing[i] as HTMLElement);
      }

      toast.setAttribute("data-toast", "");
      container.appendChild(toast);

      // Enter animation: start shifted + transparent, transition in
      const fromTop = (container.getAttribute("data-position") || "").startsWith("top");
      toast.style.opacity = "0";
      toast.style.transform = fromTop ? "translateY(-8px)" : "translateY(8px)";
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          toast.style.opacity = "";
          toast.style.transform = "";
        });
      });

      // Pause auto-dismiss while hovered so toasts don't vanish mid-read
      toast.addEventListener("mouseenter", () => {
        const timer = this.timers.get(toast);
        if (!timer) return;
        window.clearTimeout(timer.id);
        timer.remaining -= Date.now() - timer.startedAt;
      });
      toast.addEventListener("mouseleave", () => {
        const timer = this.timers.get(toast);
        if (!timer || timer.remaining <= 0) return;
        timer.startedAt = Date.now();
        timer.id = window.setTimeout(() => this.dismiss(toast), timer.remaining);
      });

      this.startTimer(toast, duration);

      return toast;
    }

    // Replaces a live toast's content and restarts its timer (used by promise)
    update(toast: HTMLElement, options: ToastOptions | string) {
      const opts: ToastOptions =
        typeof options === "string" ? { description: options } : options;
      const { duration = 4000 } = opts;
      this.renderContent(toast, opts);
      this.startTimer(toast, duration);
      return toast;
    }

    dismiss(toast: HTMLElement) {
      this.clearTimer(toast);
      this.timers.delete(toast);
      toast.style.opacity = "0";
      setTimeout(() => toast.remove(), 150);
    }

    promise<T>(promise: Promise<T>, messages: ToastPromiseMessages<T>) {
      const loadingOpts =
        typeof messages.loading === "string"
          ? { description: messages.loading }
          : messages.loading;
      const toast = this.show({ ...loadingOpts, type: "loading", duration: 0 });

      const resolveMessage = (
        message: ToastMessage | ((arg: any) => ToastMessage),
        arg: unknown
      ): Omit<ToastOptions, "type"> => {
        const resolved = typeof message === "function" ? message(arg) : message;
        return typeof resolved === "string" ? { description: resolved } : resolved;
      };

      promise.then(
        (value) => {
          const opts = resolveMessage(messages.success, value);
          if (toast) this.update(toast, { ...opts, type: "success" });
          else this.show({ ...opts, type: "success" });
        },
        (reason) => {
          const opts = resolveMessage(messages.error, reason);
          if (toast) this.update(toast, { ...opts, type: "destructive" });
          else this.show({ ...opts, type: "destructive" });
        }
      );

      return promise;
    }

    success(options: Omit<ToastOptions, "type"> | string) {
      const opts =
        typeof options === "string" ? { description: options } : options;
      return this.show({ ...opts, type: "success" });
    }

    destructive(options: Omit<ToastOptions, "type"> | string) {
      const opts =
        typeof options === "string" ? { description: options } : options;
      return this.show({ ...opts, type: "destructive" });
    }

    warning(options: Omit<ToastOptions, "type"> | string) {
      const opts =
        typeof options === "string" ? { description: options } : options;
      return this.show({ ...opts, type: "warning" });
    }

    info(options: Omit<ToastOptions, "type"> | string) {
      const opts =
        typeof options === "string" ? { description: options } : options;
      return this.show({ ...opts, type: "info" });
    }
  }

  // Initialize and expose globally
  const toastManager = new ToastManager();

  // @ts-ignore
  window.toast = (options: ToastOptions | string) => toastManager.show(options);
  // @ts-ignore
  window.toast.success = (options: Omit<ToastOptions, "type"> | string) =>
    toastManager.success(options);
  // @ts-ignore
  window.toast.destructive = (options: Omit<ToastOptions, "type"> | string) =>
    toastManager.destructive(options);
  // @ts-ignore
  window.toast.warning = (options: Omit<ToastOptions, "type"> | string) =>
    toastManager.warning(options);
  // @ts-ignore
  window.toast.info = (options: Omit<ToastOptions, "type"> | string) =>
    toastManager.info(options);
  // @ts-ignore
  window.toast.promise = <T,>(promise: Promise<T>, messages: ToastPromiseMessages<T>) =>
    toastManager.promise(promise, messages);
  // @ts-ignore
  window.toast.dismiss = (toast: HTMLElement) => toastManager.dismiss(toast);
</script>
