---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";
import HugeIcon from "../icon/HugeIcon.astro";
import { Cancel01Icon } from "../icon/icons";

export interface Props extends HTMLAttributes<"div"> {
  variant?: "default" | "destructive" | "success" | "warning" | "info";
}

const { variant = "default", class: className, ...props } = Astro.props;

const baseStyles =
  "group pointer-events-auto relative flex w-full items-center justify-between space-x-4 overflow-hidden rounded-lg border p-6 pr-8 shadow-lg transition-all";

const variantStyles = {
  default: "bg-background text-foreground border",
  destructive:
    "destructive group border-destructive bg-destructive text-destructive-foreground",
  success: "border-success bg-success/5 text-foreground",
  warning: "border-warning bg-warning/5 text-foreground",
  info: "border-info bg-info/5 text-foreground",
};

const classes = cn(baseStyles, variantStyles[variant], className);
---

<div class={classes} role="alert" data-toast {...props}>
  <slot />
  <button
    type="button"
    class="absolute right-2 top-2 rounded-md p-1 text-foreground/50 opacity-0 transition-opacity hover:text-foreground focus:opacity-100 focus:outline-none focus:ring-2 group-hover:opacity-100"
    data-toast-close
  >
    <HugeIcon icon={Cancel01Icon} size={16} />
  </button>
</div>

<script>
  const initToastCloseButtons = () => {
    document.querySelectorAll("[data-toast-close]").forEach((btn) => {
      if (btn.hasAttribute("data-initialized")) return;
      btn.setAttribute("data-initialized", "true");

      btn.addEventListener("click", () => {
        const toast = btn.closest("[data-toast]");
        if (toast) {
          toast.remove();
        }
      });
    });
  };

  initToastCloseButtons();
  document.addEventListener("astro:page-load", initToastCloseButtons);
</script>
