---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"a">, "type"> {
  /** Renders an anchor when set, a button otherwise (matches Button). */
  href?: string;
  isActive?: boolean;
  size?: "sm" | "default" | "lg";
  /** Square link sized for a single icon or page number (matches Button's iconOnly). */
  iconOnly?: boolean;
}

const {
  href,
  isActive = false,
  size = "default",
  iconOnly = true,
  class: className,
  ...props
} = Astro.props;

const sizeStyles = {
  sm: "h-8 px-3 text-xs",
  default: "h-9 px-4 py-2",
  lg: "h-10 px-8",
};

const iconOnlySizeStyles = {
  sm: "size-8 text-xs",
  default: "size-9",
  lg: "size-10",
};

const classes = cn(
  "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium cursor-pointer",
  "transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
  "disabled:pointer-events-none disabled:opacity-50",
  isActive
    ? "border border-input bg-background hover:bg-accent hover:text-accent-foreground"
    : "hover:bg-accent hover:text-accent-foreground",
  iconOnly ? iconOnlySizeStyles[size] : sizeStyles[size],
  className
);
---

{
  href ? (
    <a
      href={href}
      aria-current={isActive ? "page" : undefined}
      class={classes}
      {...props}
    >
      <slot />
    </a>
  ) : (
    <button
      type="button"
      aria-current={isActive ? "page" : undefined}
      class={classes}
      {...props}
    >
      <slot />
    </button>
  )
}
