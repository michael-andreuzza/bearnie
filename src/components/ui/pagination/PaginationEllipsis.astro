---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";
import HugeIcon from "../icon/HugeIcon.astro";
import { MoreHorizontalIcon } from "../icon/icons";

export interface Props extends HTMLAttributes<"span"> {}

const { class: className, ...props } = Astro.props;

const classes = cn(
  "flex size-9 items-center justify-center",
  className
);
---

<span class={classes} {...props}>
  <HugeIcon icon={MoreHorizontalIcon} class="size-4" aria-hidden="true" />
  <span class="sr-only">More pages</span>
</span>
